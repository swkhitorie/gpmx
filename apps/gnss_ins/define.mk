
BUILD_COMPILE_OPTIMIZE:=-O1
BUILD_C_STANDARD:=gnu11
BUILD_CXX_STANDARD:=gnu++17

CONFIG_TEST=y
CONFIG_POSIXRUN_ENABLE=y
CONFIG_FREERTOS_ENABLE=n
CONFIG_RTTNANO_ENABLE=n
CONFIG_RTOS_COMPILER="none"
CONFIG_RTOS_MEM_METHOD=1
CONFIG_GMSH=n
CONFIG_FINSH=n

CONFIG_CMBACKTRACE=n
CONFIG_HRT=y
CONFIG_HRT_POSIX2=y
CONFIG_KPRINTF=n

CONFIG_LIBC_QUEUE=y
CONFIG_LIBC_MQUEUE=n
CONFIG_LIBC_PTHREAD=n
CONFIG_LIBC_SEMAPHORE=n
CONFIG_LIBC_SEMAPHORE_INHERIT=n
CONFIG_LIBC_TIMER=n
CONFIG_LIBC_TIME=n
CONFIG_LIBCPP=n
CONFIG_LIBC_VFS=n
CONFIG_PIPES=n

CONFIG_MODULE_BUILTIN=y
CONFIG_MODULE_READLINE=y
CONFIG_MODULE_NSHLIB=y
CONFIG_MODULE_PERF=y
CONFIG_MODULE_WORKQUEUE=y
CONFIG_MODULE_WQUEUE=y
CONFIG_ORB_USE_PUBLISHER_RULES=y

CONFIG_READLINE_ECHO=n
CONFIG_READLINE_MAX_BUILTINS=20

CONFIG_NSH_LIBRARY=1
CONFIG_NSH_READLINE=1
CONFIG_NSH_LINELEN=128
CONFIG_NSH_QUOTE=1
CONFIG_NSH_CMDPARMS=1
CONFIG_NSH_MAXARGUMENTS=15
CONFIG_NSH_ARGCAT=1
CONFIG_NSH_NESTDEPTH=8
CONFIG_NSH_BUILTIN_APPS=1
CONFIG_NSH_VARS=1
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_CONSOLE=1
CONFIG_NSH_PROMPT_STRING="nsh>\x20"
CONFIG_NSH_RUNPWD="/home/miku/__workplace/gpmx/apps/gnss_ins/config/rcS"

CONFIG_SENSORS_VEHICLE_AIRSPEED=1
CONFIG_SENSORS_VEHICLE_AIR_DATA=1
CONFIG_SENSORS_VEHICLE_ANGULAR_VELOCITY=1
CONFIG_SENSORS_VEHICLE_ACCELERATION=1
CONFIG_SENSORS_VEHICLE_GPS_POSITION=1
CONFIG_SENSORS_VEHICLE_MAGNETOMETER=1
CONFIG_SENSORS_VEHICLE_OPTICAL_FLOW=1

CONFIG_EKF2_MULTI_INSTANCE=1
CONFIG_EKF2_AIRSPEED=1
CONFIG_EKF2_AUXVEL=1
CONFIG_EKF2_BARO_COMPENSATION=1
CONFIG_EKF2_DRAG_FUSION=1
CONFIG_EKF2_EXTERNAL_VISION=1
CONFIG_EKF2_GNSS_YAW=1
CONFIG_EKF2_OPTICAL_FLOW=1
CONFIG_EKF2_RANGE_FINDER=1
CONFIG_EKF2_SIDESLIP=1

CONFIG_REPLAY_EKF2_TIMESTAMP_EDIT=1

OS_CDEFS += ENABLE_LOCKSTEP_SCHEDULER
OS_CDEFS += __PX4_POSIX

PROJ_CDEFS += CONFIG_SDK_ROOTDIR="${SDK_ROOTDIR}"
PROJ_CDEFS += CONFIG_APP_ROOTDIR="${SDK_ROOTDIR}/build/${PROJ_NAME}/"
PROJ_CDEFS += CONFIG_SRC_ROOTDIR="${SDK_ROOTDIR}/${APP_PROJ_DIR}/"

PROJ_CINCDIRS += ${APP_PROJ_DIR}
CPPSOURCES += ${APP_PROJ_DIR}/app_main.cpp

PROJ_CINCDIRS += apps/libs/cJSON
CSOURCES += apps/libs/cJSON/cJSON_Utils.c
CSOURCES += apps/libs/cJSON/cJSON.c

include ${SDK_ROOTDIR}/apps/libs/px4/config.mk
include ${SDK_ROOTDIR}/gpm/config.mk

ifeq (${CONFIG_TEST},y)
EXT_LIBS += gtest_main gtest
endif
